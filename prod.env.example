# Copy to prod.env (gitignored) and fill values.
# CI deploy rewrites this from GitHub secrets.

ENV='production'
LOG_LEVEL='INFO'
SERVICE_NAME='e-bank-api'
RESET_ENABLED='false'
LEGACY_CHALLENGE_ROUTES='false'

DATABASE_URL='postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/e_bank?sslmode=require'
REDIS_URL='rediss://default:PASSWORD@HOST.upstash.io:6379'

IDEMPOTENCY_ENABLED='true'
IDEMPOTENCY_EXCLUDE_PATHS='/health,/ready,/metrics'
RATE_LIMIT_ENABLED='true'
RATE_LIMIT_REQUESTS='60'
RATE_LIMIT_WINDOW_SECONDS='60'

OIDC_ENABLED='true'
OIDC_ISSUER='https://auth.kalke.dev/realms/kalke'
OIDC_AUDIENCE='e-bank-api'

# Must match Auth BFF EBANK_USER_FORWARD_SECRET.
M2M_USER_FORWARD_SECRET=''

WELCOME_AMOUNT='10000.00'
WELCOME_CURRENCY='USD'
MAX_TRANSFER_AMOUNT='10000.00'
MAX_WITHDRAW_AMOUNT='10000.00'

CORS_ORIGINS='https://kalke.dev,https://www.kalke.dev'
