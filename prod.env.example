# Copy to prod.env (gitignored) and fill values.
# Prefer AWS Secrets Manager (SECRET_ID) for secrets; this file can be slim:
#   AWS_REGION / SECRET_ID / S3_BANK_PDF_BUCKET / POSTGRES_PASSWORD
# Compose pins DATABASE_URL to Docker ebank-db (not public). Do not open :5432.
# WARP + Zero Trust private route: DBeaver host 172.18.10.11 (ebank / ebank). SSL off.

ENV='production'
LOG_LEVEL='INFO'
LOG_FORMAT='json'
SERVICE_NAME='e-bank-api'
RESET_ENABLED='false'
LEGACY_CHALLENGE_ROUTES='false'

AWS_REGION='us-east-1'
SECRET_ID='kalke/e-bank-api/prod'
S3_BANK_PDF_BUCKET='kalke-bank-pdfs-ACCOUNT'

DATABASE_URL='postgresql+asyncpg://ebank:PASSWORD@ebank-db:5432/ebank'
POSTGRES_USER='ebank'
POSTGRES_PASSWORD=''
POSTGRES_DB='ebank'
REDIS_URL='rediss://default:PASSWORD@HOST.upstash.io:6379'

IDEMPOTENCY_ENABLED='true'
IDEMPOTENCY_EXCLUDE_PATHS='/health,/ready,/metrics'
RATE_LIMIT_ENABLED='true'
RATE_LIMIT_REQUESTS='60'
RATE_LIMIT_WINDOW_SECONDS='60'

OIDC_ENABLED='true'
OIDC_ISSUER='https://auth.kalke.dev/realms/kalke'
OIDC_AUDIENCE='e-bank-api'
# Reachable discovery on the shared Docker network (JWT iss stays OIDC_ISSUER).
OIDC_DISCOVERY_URL='http://auth:8081/realms/kalke'

# Must match Auth BFF EBANK_USER_FORWARD_SECRET.
M2M_USER_FORWARD_SECRET=''

WELCOME_AMOUNT='10000.00'
WELCOME_CURRENCY='USD'
MAX_TRANSFER_AMOUNT='10000.00'
MAX_WITHDRAW_AMOUNT='10000.00'

CORS_ORIGINS='https://kalke.dev,https://www.kalke.dev'
