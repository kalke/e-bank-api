{
  "info": {
    "_postman_id": "ebanx-bank-api-collection",
    "name": "EBANX Bank API",
    "description": "Bank account API for the EBANX technical challenge.\n\n**Before importing:** start the server (`uvicorn app.main:app --host 0.0.0.0 --port 3000 --reload`).\n\n**Import:** Postman → Import → select this file and `EBANX-Bank-API.postman_environment.json` → activate environment **EBANX Bank API - Local**.\n\n**ngrok:** set `baseUrl` to your HTTPS forwarding URL (e.g. `https://xxxx.ngrok-free.app`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Reset state",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/reset",
            "description": "Clears all accounts. Returns **200** with empty body. Run before a test flow."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Balance",
      "item": [
        {
          "name": "Get balance (account exists)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/balance?account_id={{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["balance"],
              "query": [
                {
                  "key": "account_id",
                  "value": "{{accountId}}",
                  "description": "Account ID (string)"
                }
              ]
            },
            "description": "Returns **200** with plain-text balance (e.g. `20`). Read-only."
          },
          "response": []
        },
        {
          "name": "Get balance (account not found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/balance?account_id=1234",
              "host": ["{{baseUrl}}"],
              "path": ["balance"],
              "query": [
                {
                  "key": "account_id",
                  "value": "1234"
                }
              ]
            },
            "description": "Returns **404**, body `0`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Deposit (create account)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"deposit\",\n  \"destination\": \"{{accountId}}\",\n  \"amount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "Creates account if needed. **201** → `{\"destination\": {\"id\": \"...\", \"balance\": ...}}`"
          },
          "response": []
        },
        {
          "name": "Deposit (existing account)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"deposit\",\n  \"destination\": \"100\",\n  \"amount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "Second deposit on account `100`. Expect balance **20** after two deposits of 10."
          },
          "response": []
        },
        {
          "name": "Withdraw (success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"withdraw\",\n  \"origin\": \"{{originId}}\",\n  \"amount\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "**201** → `{\"origin\": {\"id\": \"...\", \"balance\": ...}}`"
          },
          "response": []
        },
        {
          "name": "Withdraw (unknown account)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"withdraw\",\n  \"origin\": \"200\",\n  \"amount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "**404**, body `0`."
          },
          "response": []
        },
        {
          "name": "Withdraw (insufficient funds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"withdraw\",\n  \"origin\": \"100\",\n  \"amount\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "**400**, body `0`. State unchanged."
          },
          "response": []
        },
        {
          "name": "Transfer (success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"transfer\",\n  \"origin\": \"{{originId}}\",\n  \"destination\": \"{{destinationId}}\",\n  \"amount\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "**201** with `origin` and `destination`. Destination is created if missing."
          },
          "response": []
        },
        {
          "name": "Transfer (unknown origin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"transfer\",\n  \"origin\": \"200\",\n  \"amount\": 15,\n  \"destination\": \"300\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "**404**, body `0`."
          },
          "response": []
        },
        {
          "name": "Transfer (insufficient funds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"transfer\",\n  \"origin\": \"100\",\n  \"amount\": 999,\n  \"destination\": \"300\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/event",
            "description": "**400**, body `0`. State unchanged."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Challenge flow (run in order)",
      "description": "Mirrors the official challenge sequence. Run **Reset** first, then each request top to bottom.",
      "item": [
        {
          "name": "1. Reset",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/reset"
          },
          "response": []
        },
        {
          "name": "2. Balance — not found (1234)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/balance?account_id=1234"
          },
          "response": []
        },
        {
          "name": "3. Deposit — 10 to 100",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"deposit\",\"destination\":\"100\",\"amount\":10}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/event"
          },
          "response": []
        },
        {
          "name": "4. Deposit — 10 to 100 again",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"deposit\",\"destination\":\"100\",\"amount\":10}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/event"
          },
          "response": []
        },
        {
          "name": "5. Balance — 100 (expect 20)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/balance?account_id=100"
          },
          "response": []
        },
        {
          "name": "6. Withdraw — unknown 200",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"withdraw\",\"origin\":\"200\",\"amount\":10}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/event"
          },
          "response": []
        },
        {
          "name": "7. Withdraw — 5 from 100",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"withdraw\",\"origin\":\"100\",\"amount\":5}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/event"
          },
          "response": []
        },
        {
          "name": "8. Transfer — 100 to 300 (15)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"transfer\",\"origin\":\"100\",\"amount\":15,\"destination\":\"300\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/event"
          },
          "response": []
        },
        {
          "name": "9. Transfer — unknown origin 200",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"transfer\",\"origin\":\"200\",\"amount\":15,\"destination\":\"300\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/event"
          },
          "response": []
        }
      ]
    }
  ]
}
