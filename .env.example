# App
ENV=development
LOG_LEVEL=DEBUG
SERVICE_NAME=e-bank-api

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ebank:ebank@postgres:5432/ebank
DATABASE_URL_TEST=sqlite+aiosqlite:///:memory:
POSTGRES_USER=ebank
POSTGRES_PASSWORD=ebank
POSTGRES_DB=ebank

# Idempotency
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_EXCLUDE_PATHS=/health,/metrics

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL_PROCESSING=30
REDIS_TTL_COMPLETED=86400

# OIDC (kalke-auth). Set OIDC_ENABLED=false only for local unit tests.
OIDC_ENABLED=true
OIDC_ISSUER=http://localhost:8443/realms/kalke
OIDC_AUDIENCE=e-bank-api
# Docker API → Caddy on shared network kalke-auth:
OIDC_DISCOVERY_URL=http://caddy:8443/realms/kalke

# Browser sandbox (kalke.dev)
CORS_ORIGINS=https://kalke.dev,https://www.kalke.dev,http://localhost:5173,http://127.0.0.1:5173
