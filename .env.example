# App
ENV=development
LOG_LEVEL=DEBUG
SERVICE_NAME=e-bank-api
# Production disables /reset unless explicitly set true.
RESET_ENABLED=true
LEGACY_CHALLENGE_ROUTES=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ebank:ebank@postgres:5432/ebank
DATABASE_URL_TEST=sqlite+aiosqlite:///:memory:
POSTGRES_USER=ebank
POSTGRES_PASSWORD=ebank
POSTGRES_DB=ebank

# Idempotency
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_EXCLUDE_PATHS=/health,/ready,/metrics

# Rate limiting (demo mutating routes)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL_PROCESSING=30
REDIS_TTL_COMPLETED=86400

# OIDC (kalke-auth). Set OIDC_ENABLED=false only for local unit tests.
OIDC_ENABLED=true
OIDC_ISSUER=http://localhost:8443/realms/kalke
OIDC_AUDIENCE=e-bank-api
# Docker API → Caddy on shared network kalke-auth:
OIDC_DISCOVERY_URL=http://caddy:8443/realms/kalke

# BFF user-forward (must match kalke-auth EBANK_USER_FORWARD_SECRET)
M2M_USER_FORWARD_SECRET=change-me-local-forward-secret

# Demo bank
WELCOME_AMOUNT=10000.00
WELCOME_CURRENCY=USD
MAX_TRANSFER_AMOUNT=10000.00
MAX_WITHDRAW_AMOUNT=10000.00

# Browser sandbox (kalke.dev)
CORS_ORIGINS=https://kalke.dev,https://www.kalke.dev,http://localhost:5173,http://127.0.0.1:5173
